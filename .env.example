# election2026 — API keys (all optional; the pipeline degrades gracefully).
# Copy to .env and export, or set in your shell. NEVER commit real keys.

# Track A ------------------------------------------------------------------
# Kalshi public elections API works without auth; a key only raises limits.
KALSHI_API_KEY=

# Track B ------------------------------------------------------------------
# FEC (free key via https://api.data.gov/signup/) — strongest Track B source.
FEC_API_KEY=

# YouTube Data API v3 (free tier ~10,000 units/day; a budget tracker in
# track_b/quota.py refuses calls past youtube_daily_budget in config.py).
YOUTUBE_API_KEY=

# Comments -----------------------------------------------------------------
# Set to 1 to enable LLM-generated race comments (needs ANTHROPIC_API_KEY);
# any failure falls back to the rule-based Korean generator.
ELECTION2026_LLM_COMMENTS=0
ANTHROPIC_API_KEY=
